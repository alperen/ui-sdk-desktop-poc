  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/browser-playwright": "^5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "lefthook": "2.2.2",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.0.0",
    "typescript": "5.9.3",
